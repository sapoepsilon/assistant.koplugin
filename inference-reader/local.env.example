# Copy to inference-reader/local.env (gitignored) and fill in. deploy.sh sources it.
# Key: either inline or a path to a file whose first line is the key.
PROXY_API_KEY=
# PROXY_API_KEY_FILE=~/.config/koreader-proxy.key
PROXY_LAN_URL=http://192.168.50.31:8317/v1
# Placeholder: same as LAN until the proxy (VM102) has its own Tailscale address.
PROXY_TS_URL=http://192.168.50.31:8317/v1
PROXY_MODEL=hermes-default
# adb transport (defaults shown); KR_SSH is ignored with --local
KR_SSH=ubuntu@192.168.50.179
KR_ADB=/opt/android-sdk/platform-tools/adb
KR_SERIAL=adb-4A291FDKD000WL-B4mSIf._adb-tls-connect._tcp
